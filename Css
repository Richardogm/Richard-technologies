
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #071426;
  color: #ffffff;
  line-height: 1.7;
}

header {
  background: #0d2038;
  padding: 22px 6%;
  border-bottom: 1px solid #183957;
}

.logo {
  color: #38bdf8;
  font-size: 23px;
  font-weight: bold;
}

nav {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 15px;
}

nav a {
  color: white;
  text-decoration: none;
  font-size: 15px;
}

nav a:hover {
  color: #38bdf8;
}

.hero {
  padding: 90px 7%;
  text-align: center;
  background: linear-gradient(135deg, #071426, #12345a);
}

.hero h1 {
  font-size: clamp(32px, 7vw, 55px);
  margin-bottom: 18px;
}

.hero span {
  color: #38bdf8;
}

.hero p {
  color: #cbd5e1;
  max-width: 650px;
  margin: 0 auto 25px;
}

.button {
  display: inline-block;
  padding: 13px 25px;
  background: #0284c7;
  color: white;
  text-decoration: none;
  border-radius: 7px;
}

section {
  padding: 65px 7%;
}

section h2 {
  color: #38bdf8;
  font-size: 30px;
  margin-bottom: 20px;
}

.services {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 25px;
}

.card {
  background: #10243c;
  padding: 28px;
  border: 1px solid #1d4264;
  border-radius: 12px;
}

.card h3 {
  color: #38bdf8;
  margin-bottom: 12px;
}

footer {
  background: #0d2038;
  padding: 30px;
  text-align: center;
  color: #cbd5e1;
}
